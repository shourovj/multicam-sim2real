{
 "format": "p2s-spec",
 "version": 1,
 "writer": "hand-written reference (2026-11-25)",
 "prompt": "A Franka Panda arm on a table pours water from a pitcher into a glass. Views: a wrist camera, a side tripod and a CCTV camera in the corner of the room.",
 "setting": {"place": "a room"},
 "objects": [
  {"name": "arm", "class": "robot_arm", "span": "A Franka Panda arm"},
  {"name": "table", "class": "table", "span": "on a table"},
  {"name": "pitcher", "class": "pitcher", "span": "a pitcher"},
  {"name": "glass", "class": "cup", "span": "a glass"},
  {"name": "water", "class": "water", "span": "pours water"}
 ],
 "parts": [],
 "cameras": [
  {"name": "wrist", "type": "attached", "on": "arm", "span": "a wrist camera"},
  {"name": "tripod", "type": "fixed", "span": "a side tripod"},
  {"name": "cctv", "type": "fixed", "min_height_m": 2, "span": "a CCTV camera in the corner of the room"}
 ],
 "requirements": [
  {"id": "arm_on_table", "mode": "spatial", "text": "the arm stands on the table", "formula": "G near(arm, table, 0.05)"},
  {"id": "glass_on_table", "mode": "spatial", "text": "the glass stands on the table", "formula": "G on(glass, table)"},
  {"id": "pitcher_tilts", "mode": "action", "text": "the arm tilts the pitcher to pour", "formula": "F turned(pitcher, 20)"},
  {"id": "water_from_pitcher", "mode": "action", "text": "the water starts in the pitcher", "formula": "fills(pitcher, water, 0.8)"},
  {"id": "water_into_glass", "mode": "action", "text": "the water pours from the pitcher into the glass", "formula": "seq(fills(pitcher, water, 0.8), fills(glass, water, 0.5))"},
  {"id": "glass_stays", "mode": "consistency", "implied": true, "text": "the glass is not knocked over", "formula": "G upright(glass, 20)"},
  {"id": "wrist_sees_glass", "mode": "camera", "text": "the wrist camera sees the glass during the pour", "formula": "F (turned(pitcher, 20) & visible(wrist, glass))"},
  {"id": "tripod_sees_pour", "mode": "camera", "text": "the side tripod shows the pour", "formula": "F (turned(pitcher, 20) & visible(tripod, pitcher) & visible(tripod, glass))"},
  {"id": "cctv_sees_pour", "mode": "camera", "text": "the CCTV camera shows the arm pouring", "formula": "F (turned(pitcher, 20) & visible(cctv, arm) & visible(cctv, glass))"}
 ],
 "not_simulated": ["the room's walls and furnishing"]
}
